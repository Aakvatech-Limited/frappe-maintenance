{
  "organization": "Aakvatech-Limited",
  "repository_include_regex": ".*",
  "repository_exclude_regex": "^frappe-maintenance$",
  "default_branch_only": false,
  "include_default_branch": true,
  "branch_include_regex": "^version-\\d+(?:-hotfix)?$",
  "required_paths": [
    "*/hooks.py"
  ],
  "required_paths_mode": "exactly_one_each",
  "files": [
    {
      "source": "templates/pre-commit-config.yaml",
      "target": ".pre-commit-config.yaml",
      "mode": "create_or_update"
    },
    {
      "source": "templates/ruff.toml",
      "target": "ruff.toml",
      "mode": "create_or_update"
    },
    {
      "source": "templates/commitlint.config.js",
      "target": "commitlint.config.js",
      "mode": "create_or_update"
    },
    {
      "source": "templates/setup-git-hooks.sh",
      "target": "scripts/setup-git-hooks.sh",
      "mode": "create_or_update"
    },
    {
      "source": "templates/editorconfig",
      "target": ".editorconfig",
      "mode": "create_or_update"
    },
    {
      "source": "templates/eslintrc",
      "target": ".eslintrc",
      "mode": "create_or_update"
    },
    {
      "source": "templates/workflows/backport.yml",
      "target": ".github/workflows/backport.yml",
      "mode": "create_or_update"
    },
    {
      "source": "templates/workflows/custom-app-compliance.yml",
      "target": ".github/workflows/custom-app-compliance.yml",
      "mode": "create_or_update"
    },
    {
      "source": "templates/workflows/label-failed-prs.yml",
      "target": ".github/workflows/label-failed-prs.yml",
      "mode": "create_or_update"
    },
    {
      "source": "templates/workflows/linter.yml",
      "target": ".github/workflows/linter.yml",
      "mode": "create_or_update"
    },
    {
      "source": "templates/workflows/modernize-frappe.yml",
      "target": ".github/workflows/modernize-frappe.yml",
      "mode": "create_or_update"
    },
    {
      "source": "templates/workflows/no-raw-sql.yml",
      "target": ".github/workflows/no-raw-sql.yml",
      "mode": "create_or_update"
    },
    {
      "source": "templates/workflows/pre-commit.yml",
      "target": ".github/workflows/pre-commit.yml",
      "mode": "create_or_update"
    },
    {
      "source": "templates/workflows/semantic-commits.yml",
      "target": ".github/workflows/semantic-commits.yml",
      "mode": "create_or_update"
    },
    {
      "source": "templates/workflows/semgrep.yml",
      "target": ".github/workflows/semgrep.yml",
      "mode": "create_or_update"
    },
    {
      "source": "templates/workflows/tag-and-promote-from-pr-label.yml",
      "target": ".github/workflows/tag-and-promote-from-pr-label.yml",
      "mode": "create_or_update"
    }
  ],
  "work_branch_prefix": "automation/sync-app-ci",
  "commit_message": "chore: sync CI and lint config from frappe-maintenance",
  "pr_title": "chore: sync CI and lint config from frappe-maintenance",
  "pr_body": "Updates the CI, lint and hook files that Aakvatech-Limited/frappe-maintenance manages. Do not edit these files in this app; change the templates in frappe-maintenance. The pre-commit check fails when they differ from frappe-maintenance.",
  "required_workflow_source": {
    "repository": "Aakvatech-Limited/frappe-maintenance",
    "ref": "stable"
  }
}
